# ==============================================================================
# Modelo de Credenciais (.env.example)
# Copie este arquivo para ".env" e preencha os valores abaixo.
# Se deixado em branco, o robô usará o Gerenciador de Credenciais do Windows.
# ==============================================================================

# Acesso ao Portal Vivo Empresas (CPF de 11 dígitos e senha)
VIVO_CPF=
VIVO_SENHA=

# Integração com a API do Zabbix
ZABBIX_API_URL=http://172.16.2.250/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_AUTOMATICO=sim

